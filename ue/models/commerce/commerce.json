  "models": [
    {
      "id": "product-list-page",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "urlPath",
          "label": "Caminho da categoria",
          "description": "Ex.: apparel. Em branco = página de resultados da busca."
        }
      ]
    },
    {
      "id": "product-details",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "defaultSku",
          "label": "SKU padrão",
          "description": "Usado quando a URL não traz o SKU (ex.: no editor)."
        }
      ]
    },
    {
      "id": "product-recommendations",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "recId",
          "label": "ID da unidade de recomendação",
          "description": "Criada em Marketing > Product Recommendations no Commerce."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "currentSku",
          "label": "SKU de contexto (opcional)"
        }
      ]
    },
    {
      "id": "enrichment",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "type",
          "label": "Tipo",
          "options": [
            {
              "name": "Produto",
              "value": "Product"
            },
            {
              "name": "Categoria",
              "value": "category"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "position",
          "label": "Posição",
          "description": "Ex.: below-product, below-category"
        }
      ]
    },
    {
      "id": "commerce-account-header",
      "fields": [
        {
          "component": "text",
