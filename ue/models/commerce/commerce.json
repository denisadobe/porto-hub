          "unsafeHTML": "<div class=\"product-recommendations\"><div><div>recId</div><div></div></div><div><div>currentSku</div><div></div></div></div>",
          "fields": [
            {
              "name": "recId",
              "selector": "div:nth-child(1)>div:nth-child(2)"
            },
            {
              "name": "currentSku",
              "selector": "div:nth-child(2)>div:nth-child(2)"
            }
          ]
        }
      }
    },
