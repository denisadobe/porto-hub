{
  "definitions": [
    {
      "title": "Lista de produtos (categoria ou busca)",
      "id": "product-list-page",
      "model": "product-list-page",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"product-list-page\"><div><div>urlPath</div><div></div></div></div>",
          "fields": [
            {
              "name": "urlPath",
              "selector": "div:nth-child(1)>div:nth-child(2)"
            }
          ]
        }
      }
    },
    {
      "title": "Detalhes do produto",
      "id": "product-details",
      "model": "product-details",
      "plugins": {
        "da": {
          "unsafeHTML": "<div class=\"product-details\"><div><div>defaultSku</div><div></div></div></div>",
          "fields": [
            {
              "name": "defaultSku",
              "selector": "div:nth-child(1)>div:nth-child(2)"
            }
          ]
        }
      }
    },
    {
      "title": "Recomendações de produtos",
      "id": "product-recommendations",
