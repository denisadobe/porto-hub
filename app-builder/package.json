{
  "name": "porto-servico",
  "version": "0.1.0",
  "private": true,
  "description": "Porto Serviço demo: coverage by CEP, scheduling and reservations (Adobe App Builder)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jest --ci",
    "postinstall": "npx aio-commerce-lib-app hooks postinstall"
  },
  "dependencies": {
    "@adobe/aio-commerce-lib-admin-ui": "^1.3.0",
    "@adobe/aio-commerce-lib-app": "^2.2.0",
    "@adobe/aio-commerce-sdk": "^2.1.0",
    "@adobe/aio-lib-state": "^5.4.0",
    "@react-spectrum/s2": "^1.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "imports": {
    "#app.commerce.config": "./src/commerce-extensibility-1/.generated/app.commerce.config.js",
    "#web/*": "./src/commerce-backend-ui-2/web-src/src/*"
  },
  "@parcel/bundler-default": {
    "manualSharedBundles": [
      {
        "assets": [
          "**/@react-spectrum/s2/**",
          "src/commerce-backend-ui-2/web-src/*.{js,jsx,ts,tsx}"
        ],
        "name": "s2-styles",
        "types": [
          "css"
        ]
      }
    ]
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
